---
import { DateTime } from 'luxon';

interface Props {
  title: string;
  slug: string;
  date: Date;
}

const { title, slug, date } = Astro.props;
const formattedDate = DateTime.fromJSDate(date).toFormat('yyyy-MM-dd');
const relative = DateTime.fromJSDate(date).toRelative();
---

<a
  href={`/post/${slug}`}
  data-umami-event="FeatureCard"
  class="block mb-4 p-[2px] rounded-lg bg-gradient-to-l from-[#7928CA] to-[#FF0080] transition-transform hover:scale-[1.03] lg:hover:scale-[1.1]"
>
  <div class="rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-100 p-3">
    <h3
      class="text-base xl:text-base md:text-xl font-semibold capitalize line-clamp-2 bg-gradient-to-br from-[var(--color-brand-cyan)] to-[var(--color-brand-blue)] bg-clip-text text-transparent"
    >
      {title}
    </h3>
    <time datetime={date.toISOString()} title={formattedDate} class="block py-2 text-xs opacity-80 w-fit">
      {relative}
    </time>
  </div>
</a>
