---
interface Props {
  title: string;
  url: string;
  hashtags?: string;
}
const { title, url, hashtags = '' } = Astro.props;
const enc = encodeURIComponent;
const tw = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}&hashtags=${enc(hashtags)}`;
const reddit = `http://www.reddit.com/submit?url=${enc(url)}&title=${enc(title)}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
---

<div class="flex items-center gap-2">
  <a href={tw} target="_blank" rel="noreferrer" aria-label="Share on Twitter" class="inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#1DA1F2"><path d="M22.46 6c-.77.35-1.6.59-2.46.7a4.3 4.3 0 0 0 1.88-2.37 8.59 8.59 0 0 1-2.72 1.04A4.28 4.28 0 0 0 11.5 9.5c0 .34.04.67.1.99-3.56-.18-6.72-1.89-8.83-4.5a4.28 4.28 0 0 0 1.32 5.71c-.7-.02-1.36-.21-1.94-.53v.05c0 2.07 1.47 3.8 3.42 4.2-.36.1-.74.15-1.13.15-.27 0-.54-.02-.8-.07.54 1.7 2.13 2.94 4.01 2.97A8.6 8.6 0 0 1 2 18.57 12.13 12.13 0 0 0 8.56 20.5c7.88 0 12.2-6.53 12.2-12.2 0-.19 0-.37-.01-.56A8.66 8.66 0 0 0 22.46 6z"/></svg>
  </a>
  <a href={reddit} target="_blank" rel="noreferrer" aria-label="Share on Reddit" class="inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#FF5700"><path d="M22 12.07c0-1.18-.96-2.13-2.13-2.13-.59 0-1.13.24-1.51.62-1.49-1.02-3.5-1.66-5.74-1.74l1.16-3.7 3.13.74c.04.84.74 1.51 1.6 1.51.89 0 1.6-.71 1.6-1.6 0-.88-.71-1.6-1.6-1.6-.62 0-1.16.36-1.43.89l-3.5-.83a.34.34 0 0 0-.42.24l-1.31 4.16c-2.27.06-4.31.7-5.83 1.74-.39-.39-.93-.62-1.51-.62A2.12 2.12 0 0 0 2 12.07c0 .8.45 1.5 1.11 1.85-.04.21-.06.42-.06.64 0 3.27 3.81 5.93 8.5 5.93s8.5-2.66 8.5-5.93c0-.21-.02-.43-.06-.64.66-.35 1.11-1.05 1.11-1.85zM7.36 13.6a1.34 1.34 0 1 1 2.68 0 1.34 1.34 0 0 1-2.68 0zm7.36 4.31c-.97.97-2.84 1.05-3.36 1.05-.52 0-2.39-.08-3.36-1.05a.4.4 0 0 1 0-.55.4.4 0 0 1 .55 0c.6.6 1.92.81 2.81.81.89 0 2.21-.21 2.81-.81a.4.4 0 0 1 .55 0 .4.4 0 0 1 0 .55zm-.62-2.97a1.34 1.34 0 1 1 0-2.68 1.34 1.34 0 0 1 0 2.68z"/></svg>
  </a>
  <a href={fb} target="_blank" rel="noreferrer" aria-label="Share on Facebook" class="inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.54-4.7 1.32 0 2.7.24 2.7.24v2.97h-1.52c-1.5 0-1.97.93-1.97 1.89v2.27h3.35l-.54 3.49h-2.81V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
  </a>
</div>
