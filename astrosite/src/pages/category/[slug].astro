---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import {
  postCategories,
  postsByCategory,
  uniqueCategories,
  sortPostsByDateDesc,
  categorySlug,
} from '../../lib/categories';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const cats = uniqueCategories(all);
  return cats.map((name) => ({
    params: { slug: categorySlug(name) },
    props: { name },
  }));
}

const { slug } = Astro.params;
const { name } = Astro.props as { name: string };

const all = sortPostsByDateDesc(await getCollection('blog'));
const posts = postsByCategory(all, slug!);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${siteUrl}/category/${slug}`;
const image = `${siteUrl}/og/category/${slug}.png`;

const postWord = posts.length === 1 ? 'post' : 'posts';
const title = `${name} Tutorials & Guides · CodeHiRise`;
const description = `Guides and tutorials on ${name} - ${posts.length} ${postWord} on CodeHiRise covering practical, production-focused engineering topics.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${name} Tutorials & Guides`,
  description,
  url,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/post/${post.id.replace(/\.(md|mdx)$/, '')}`,
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  url={url}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-16 min-h-[82vh]">
    <h1 class="text-5xl capitalize mb-4 bg-gradient-to-br from-[var(--color-brand-cyan)] to-[var(--color-brand-blue)] bg-clip-text text-transparent">
      {name}
    </h1>
    <p class="text-lg opacity-80 mb-8 max-w-3xl leading-relaxed">
      {description}
    </p>
    <div>
      {posts.map((post) => (
        <Card
          title={post.data.title}
          slug={post.id.replace(/\.(md|mdx)$/, '')}
          date={post.data.date}
          overview={post.data.overview}
          categories={postCategories(post)}
        />
      ))}
    </div>
  </div>
</BaseLayout>
