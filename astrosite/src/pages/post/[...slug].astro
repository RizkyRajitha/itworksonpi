---
import { getCollection, render } from "astro:content";
import { DateTime } from "luxon";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import ScrollProgress from "../../components/ScrollProgress.astro";
import PostImageDialog from "../../components/PostImageDialog.astro";
import { mdxComponents } from "../../components/mdx-components";
import { postCategories, readTime, categorySlug } from "../../lib/categories";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.(md|mdx)$/, "");
const cats = postCategories(post);
const minutes = readTime(post.body ?? "");
const formattedDate = DateTime.fromJSDate(post.data.date).toFormat(
  "yyyy-MM-dd",
);
const relative = DateTime.fromJSDate(post.data.date).toRelative();

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const url = `${siteUrl}/post/${slug}`;
const ogImage = `${siteUrl}/og/post/${slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.overview,
  image: ogImage,
  url,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: cats.join(", "),
  author: { "@type": "Person", name: "CodeHiRise", url: siteUrl },
  publisher: {
    "@type": "Organization",
    name: "CodeHiRise",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/codehiriselogo.png`,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.overview}
  image={ogImage}
  url={url}
  type="article"
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
  keywords={cats.join(", ")}
>
  <ScrollProgress />

  <article class="mx-auto max-w-7xl px-4 pt-10 pb-16">
    <header class="my-12 flex flex-col lg:flex-row lg:items-stretch gap-8">
      <div class="flex-1 flex flex-col justify-between gap-4">
        <h1
          class="text-4xl font-extrabold capitalize bg-gradient-to-br from-[var(--color-brand-cyan)] to-[var(--color-brand-blue)] bg-clip-text text-transparent line-clamp-5 text-center lg:text-left"
        >
          {post.data.title}
        </h1>
        <p class="text-lg opacity-80 text-center lg:text-left">
          {minutes}ish minutes read
        </p>

        <div class="flex justify-center lg:justify-start">
          <ShareButtons
            title={post.data.title}
            url={url}
            hashtags={cats.join(",")}
          />
        </div>

        <div class="text-center lg:text-left">
          <time
            datetime={formattedDate}
            title={formattedDate}
            class="opacity-80">{relative}</time
          >
        </div>

        <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
          {
            cats.map((c) => (
              <a
                href={`/category/${categorySlug(c)}`}
                data-umami-event="Categories"
                class="inline-block px-3 py-1.5 rounded-lg bg-green-700/20 text-green-700 dark:text-green-300 capitalize hover:bg-green-700/30"
              >
                {c}
              </a>
            ))
          }
        </div>
      </div>

      <div class="lg:w-2/5 flex items-center justify-center">
        <div
          class="group rounded-lg overflow-hidden p-4 md:p-6 bg-gradient-to-br from-[var(--color-brand-cyan)] to-[var(--color-brand-blue)]"
        >
          <img
            src={`/og/post/${slug}.png`}
            alt={`${post.data.title} cover`}
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            class="rounded-lg w-full h-auto transition-transform duration-300 ease-out group-hover:scale-x-105 group-hover:scale-y-110"
          />
        </div>
      </div>
    </header>

    <div
      class="prose-custom max-w-none text-lg leading-relaxed
      [&_h1]:text-4xl [&_h1]:py-4 [&_h1]:text-[var(--color-brand-link)]
      [&_h2]:text-3xl [&_h2]:py-4 [&_h2]:mt-4 [&_h2]:text-[var(--color-brand-link)]
      [&_h3]:text-2xl [&_h3]:py-4 [&_h3]:mt-4 [&_h3]:text-[var(--color-brand-link)]
      [&_h4]:text-lg [&_h4]:py-2 [&_h4]:text-[var(--color-brand-link)]
      [&_a]:text-[var(--color-brand-teal)] [&_a]:capitalize [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-dotted [&_a]:decoration-2 [&_a:hover]:decoration-solid
      [&_p]:text-justify [&_p]:my-2 [&_p]:leading-relaxed
      [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:py-4 [&_ul]:text-xl
      [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:py-4 [&_ol]:text-xl
      [&_blockquote]:bg-black/30 [&_blockquote]:italic [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--color-brand-teal)] [&_blockquote]:px-4 [&_blockquote]:py-3 [&_blockquote]:my-4
      [&_pre]:my-4
      [&_table]:w-full [&_table]:my-4
      [&_th]:px-3 [&_th]:py-2 [&_th]:bg-gray-200 dark:[&_th]:bg-gray-700
      [&_td]:px-3 [&_td]:py-2 [&_td]:border-b [&_td]:border-gray-300 dark:[&_td]:border-gray-700"
    >
      <Content components={mdxComponents} />
    </div>
  </article>

  <PostImageDialog />
</BaseLayout>
