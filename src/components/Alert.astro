---
interface Props {
  type?: "info" | "note" | "warning" | "success" | "error";
}
const { type = "info" } = Astro.props;

type Kind = "info" | "warning" | "success" | "error";
const kind: Kind = type === "note" ? "info" : type;

const palette: Record<Kind, string> = {
  info: "bg-blue-500/15 text-blue-100 border-blue-400",
  warning: "bg-amber-500/15 text-amber-100 border-amber-400",
  success: "bg-emerald-500/15 text-emerald-100 border-emerald-400",
  error: "bg-red-500/15 text-red-100 border-red-400",
};
const classes = palette[kind];
---

<div
  class:list={["my-6 p-4 rounded-lg border-2 flex items-center gap-3", classes]}
>
  <span class="shrink-0">
    {
      kind === "warning" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
      )
    }
    {
      kind === "success" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
      )
    }
    {
      kind === "error" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="15" y1="9" x2="9" y2="15" />
          <line x1="9" y1="9" x2="15" y2="15" />
        </svg>
      )
    }
    {
      kind === "info" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
      )
    }
  </span>
  <div class="text-base leading-relaxed [&>p]:m-0"><slot /></div>
</div>
