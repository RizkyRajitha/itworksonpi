---
interface Props {
  type?: "info" | "note" | "warning" | "success" | "error";
}

const { type = "info" } = Astro.props;
const variant = type === "note" ? "info" : type;

const classMap: Record<string, string> = {
  info: "",
  warning: "callout-warning",
  success: "callout-success",
  error: "callout-error",
};
const cls = classMap[variant] ?? "";

const icons: Record<string, string> = {
  info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>',
  warning:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>',
  success:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="M22 4 12 14.01l-3-3"></path></svg>',
  error:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M15 9l-6 6M9 9l6 6"></path></svg>',
};
const icon = icons[variant] ?? icons.info;
---

<div class:list={["callout", cls]}>
  <span class="ic"><Fragment set:html={icon} /></span>
  <div class="callout-body"><slot /></div>
</div>
