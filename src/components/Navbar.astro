---
const path = Astro.url.pathname;
const showSearch = path !== "/explore" && !path.startsWith("/explore");
---

<header class="bg-gray-100 text-gray-700 dark:bg-[#1A202C] dark:text-gray-100">
  <nav class="px-4">
    <div class="flex h-16 items-center justify-between">
      <button
        id="nav-mobile-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700"
      >
        <svg
          id="nav-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="3" y1="6" x2="21" y2="6"></line><line
            x1="3"
            y1="12"
            x2="21"
            y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
        >
        <svg
          id="nav-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>

      <a href="/" class="flex items-end gap-2" data-umami-event="Logo">
        <img
          src="/images/codehiriselogo.svg"
          alt="CodeHiRise logo"
          width="60"
          height="60"
          class="self-center"
        />
        <span
          class="text-4xl text-center"
          style="font-family: var(--font-display)">CodeHiRise</span
        >
      </a>

      <div class="flex items-center gap-2">
        {
          showSearch && (
            <form action="/explore" method="get" class="hidden md:block">
              <input
                type="text"
                name="text"
                placeholder="Explore..."
                class="px-3 py-2 rounded-md bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 placeholder:text-gray-500 dark:placeholder:text-gray-300"
              />
            </form>
          )
        }
      </div>
    </div>

    <div id="nav-mobile-panel" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-3">
        <a
          href="/explore"
          class="px-2 py-1 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700"
          >explore</a
        >
        <form action="/explore" method="get">
          <input
            type="text"
            name="text"
            placeholder="Explore..."
            class="w-full px-3 py-2 rounded-md bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 placeholder:text-gray-500 dark:placeholder:text-gray-300"
          />
        </form>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById("nav-mobile-toggle");
    const panel = document.getElementById("nav-mobile-panel");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    if (toggle && panel) {
      toggle.addEventListener("click", () => {
        const open = panel.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(open));
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
      });
    }
  })();
</script>
