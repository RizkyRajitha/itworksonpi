---
import { getCollection, render } from "astro:content";
import { DateTime } from "luxon";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import ScrollProgress from "../../components/ScrollProgress.astro";
import PostImageDialog from "../../components/PostImageDialog.astro";
import PostCover from "../../components/PostCover.astro";
import Card from "../../components/Card.astro";
import { mdxComponents } from "../../components/mdx-components";
import {
  postCategories,
  readTime,
  categorySlug,
  sortPostsByDateDesc,
} from "../../lib/categories";

const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, "");

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const slug = slugOf(post.id);
const cats = postCategories(post);
const minutes = readTime(post.body ?? "");
const formattedDate = DateTime.fromJSDate(post.data.date).toFormat("yyyy-MM-dd");
const relative = DateTime.fromJSDate(post.data.date).toRelative();

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const allPosts = sortPostsByDateDesc(await getCollection("blog"));
const related = allPosts
  .filter(
    (p) =>
      slugOf(p.id) !== slug && postCategories(p).some((c) => cats.includes(c)),
  )
  .slice(0, 3);
const pool = related.length
  ? related
  : allPosts.filter((p) => slugOf(p.id) !== slug).slice(0, 3);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const url = `${siteUrl}/post/${slug}`;
const ogImage = `${siteUrl}/og/post/${slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.overview,
  image: ogImage,
  url,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: cats.join(", "),
  author: { "@type": "Person", name: "CodeHiRise", url: siteUrl },
  publisher: {
    "@type": "Organization",
    name: "CodeHiRise",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/codehiriselogo.png`,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.overview}
  image={ogImage}
  url={url}
  type="article"
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
  keywords={cats.join(", ")}
>
  <ScrollProgress />

  <article class="wrap">
    <header class="article-head">
      <div class="breadcrumb">
        <a href="/">~</a><span class="sep">/</span>
        {
          cats[0] && (
            <>
              <a href={`/category/${categorySlug(cats[0])}`}>
                {categorySlug(cats[0])}
              </a>
              <span class="sep">/</span>
            </>
          )
        }
        <span class="faint">{slug}</span>
      </div>

      <span class="kicker">{cats.join(" · ")}</span>

      <div class="article-cover" style="margin-top:18px;">
        <PostCover
          title={post.data.title}
          slug={slug}
          categories={cats}
          size="clamp(22px,3vw,38px)"
          heading={true}
        />
      </div>

      <div class="article-meta">
        <span class="avatar">C</span>
        <span>CodeHiRise</span>
        <span class="dot"></span>
        <time datetime={formattedDate} title={formattedDate}>{relative}</time>
        <span class="dot"></span>
        <span>{minutes} min read</span>
        <span class="dot"></span>
        <ShareButtons
          title={post.data.title}
          url={url}
          hashtags={cats.join(",")}
        />
      </div>
    </header>

    {
      toc.length > 0 ? (
        <div class="post-layout">
          <div class="prose" id="prose">
            <Content components={mdxComponents} />
          </div>
          <aside>
            <nav class="toc" id="toc">
              <h4>On this page</h4>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class:list={[{ "toc-sub": h.depth === 3 }]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        </div>
      ) : (
        <div class="prose" id="prose">
          <Content components={mdxComponents} />
        </div>
      )
    }
  </article>

  <section class="wrap section">
    <div class="section-head">
      <h2>Keep reading</h2>
      <span class="idx">// related guides</span>
    </div>
    <div class="grid grid-3">
      {
        pool.map((p) => (
          <Card
            title={p.data.title}
            slug={slugOf(p.id)}
            date={p.data.date}
            overview={p.data.overview}
            categories={postCategories(p)}
            readMinutes={readTime(p.body ?? "")}
          />
        ))
      }
    </div>
  </section>

  <PostImageDialog />

  <script is:inline>
    // ---- enhance Shiki code blocks: terminal bar + copy ----
    (function enhanceCode() {
      document.querySelectorAll("#prose pre.astro-code").forEach((pre) => {
        if (pre.closest(".codeblock")) return;
        const lang = pre.getAttribute("data-language") || "code";
        const wrap = document.createElement("div");
        wrap.className = "codeblock";
        const bar = document.createElement("div");
        bar.className = "codeblock-bar";
        bar.innerHTML =
          '<span class="cover-dot"></span><span class="cover-dot"></span><span class="cover-dot"></span><span class="lang"></span><button class="copy" type="button">copy</button>';
        bar.querySelector(".lang").textContent = lang;
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(bar);
        wrap.appendChild(pre);
        const btn = bar.querySelector(".copy");
        btn.addEventListener("click", () => {
          const code = (pre.querySelector("code") || pre).innerText || "";
          navigator.clipboard && navigator.clipboard.writeText(code);
          const t = btn.textContent;
          btn.textContent = "copied";
          setTimeout(() => (btn.textContent = t), 1100);
        });
      });
    })();

    // ---- TOC active highlight ----
    (function tocHighlight() {
      const links = [...document.querySelectorAll(".toc a")];
      if (!links.length) return;
      const sections = links
        .map((l) => document.querySelector(l.getAttribute("href")))
        .filter(Boolean);
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              const id = "#" + en.target.id;
              links.forEach((l) =>
                l.classList.toggle(
                  "is-active",
                  l.getAttribute("href") === id,
                ),
              );
            }
          });
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      sections.forEach((s) => obs.observe(s));
    })();
  </script>
</BaseLayout>
